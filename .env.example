DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
DISCORD_REQUEST_CHANNEL_IDS=
# IDs de usuarios autorizados a acionar o bot por DM (separados por virgula).
# Deixe vazio para desativar o atendimento por DM. So funciona no modo listener (--listen).
DISCORD_DM_ALLOWED_USER_IDS=
DISCORD_CONFIRMATION_MODE=reaction
DISCORD_REACTION_EMOJI=
DISCORD_REPLY_TEMPLATE=Card criado no Trello: {card_url}

TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_REF=
TRELLO_TARGET_LIST_ID=
TRELLO_TARGET_LIST_NAME=
TRELLO_ONBOARDING_TEMPLATE_CARD_REF=
TRELLO_OFFBOARDING_TEMPLATE_CARD_REF=
TRELLO_KEEP_FROM_SOURCE=checklists,customFields,labels

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

GMAIL_USER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=newer_than:7d (onboarding OR offboarding OR admissao OR admissão OR contratação OR desligamento OR subject:Offboarding)
GMAIL_PROCESSED_LABEL_NAME=Infra Ops Processado
GMAIL_MAX_RESULTS=10
GMAIL_BACKFILL_ONBOARDING_DESCRIPTIONS=false

BOT_TIMEZONE=America/Sao_Paulo
LOOKBACK_DAYS=7
MAX_MESSAGES_PER_CHANNEL=500
LOG_LEVEL=INFO
